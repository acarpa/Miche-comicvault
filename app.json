{
  "expo": {
    "name": "ComicVault",
    "slug": "comicvault",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "comicvault",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0E11",
    "android": {
      "package": "com.miche.comicvault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15151A"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content", "mimeType": "application/vnd.comicbook+zip" },
            { "scheme": "content", "mimeType": "application/vnd.comicbook-rar" },
            { "scheme": "content", "mimeType": "application/x-cbz" },
            { "scheme": "content", "mimeType": "application/x-cbr" },
            { "scheme": "content", "mimeType": "application/x-cb7" },
            { "scheme": "content", "mimeType": "application/zip" },
            { "scheme": "content", "mimeType": "application/x-rar-compressed" },
            { "scheme": "content", "mimeType": "application/vnd.rar" },
            { "scheme": "content", "mimeType": "application/x-7z-compressed" },
            { "scheme": "content", "mimeType": "application/octet-stream" }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/vnd.comicbook+zip",
              "application/vnd.comicbook-rar",
              "application/x-cbz",
              "application/x-cbr",
              "application/zip",
              "application/x-rar-compressed",
              "application/vnd.rar",
              "application/x-7z-compressed",
              "application/octet-stream"
            ],
            "multipleShareMimeTypes": [
              "application/vnd.comicbook+zip",
              "application/vnd.comicbook-rar",
              "application/x-cbz",
              "application/x-cbr",
              "application/zip",
              "application/x-rar-compressed",
              "application/vnd.rar",
              "application/x-7z-compressed",
              "application/octet-stream"
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ComicVault usa il riconoscimento per sbloccare la tua libreria."
        }
      ],
      "./plugins/withAndroidBuildSettings"
    ]
  }
}
